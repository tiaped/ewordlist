{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Unicorns API",
    "description" : "An API for managing unicorn-related information",
    "version" : "1.0.0"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/unicorns" : {
      "get" : {
        "summary" : "List all unicorns",
        "description" : "Retrieve a list of all unicorns",
        "parameters" : [ {
          "name" : "per_page",
          "in" : "query",
          "description" : "Number of items per page",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Number of items per page",
            "default" : 20,
            "minimum" : 1,
            "maximum" : 100
          }
        }, {
          "name" : "page",
          "in" : "query",
          "description" : "Page number for pagination",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Page number for pagination",
            "default" : 1,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "X-Pagination-Previous" : {
                "description" : "URL of the previous page",
                "schema" : {
                  "type" : "string",
                  "description" : "URL of the previous page"
                }
              },
              "X-Pagination-Next" : {
                "description" : "URL of the next page",
                "schema" : {
                  "type" : "string",
                  "description" : "URL of the next page"
                }
              },
              "X-Pagination-Last" : {
                "description" : "URL of the last page",
                "schema" : {
                  "type" : "string",
                  "description" : "URL of the last page"
                }
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Unicorn"
                  }
                },
                "example" : [ {
                  "id" : 1,
                  "name" : "Sparkle",
                  "color" : "Pink",
                  "hornLength" : 30
                }, {
                  "id" : 2,
                  "name" : "Rainbow",
                  "color" : "Multicolored",
                  "hornLength" : 25
                } ]
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/BadRequest"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "500" : {
            "$ref" : "#/components/responses/InternalServerError"
          }
        }
      },
      "post" : {
        "summary" : "Create a new unicorn",
        "description" : "Add a new unicorn to the collection",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UnicornInput"
              },
              "example" : {
                "name" : "Starlight",
                "color" : "Purple",
                "hornLength" : 28
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "description" : "Unicorn created successfully",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Unicorn"
                },
                "example" : {
                  "id" : 3,
                  "name" : "Starlight",
                  "color" : "Purple",
                  "hornLength" : 28
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/BadRequest"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "500" : {
            "$ref" : "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/unicorns/{id}" : {
      "get" : {
        "summary" : "Get a specific unicorn",
        "description" : "Retrieve details of a specific unicorn by ID",
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Unicorn"
                },
                "example" : {
                  "id" : 1,
                  "name" : "Sparkle",
                  "color" : "Pink",
                  "hornLength" : 30
                }
              }
            }
          },
          "400" : {
            "$ref" : "#/components/responses/BadRequest"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "500" : {
            "$ref" : "#/components/responses/InternalServerError"
          }
        }
      },
      "put" : {
        "summary" : "Update a unicorn",
        "description" : "Update details of a specific unicorn by ID",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UnicornInput"
              },
              "example" : {
                "name" : "Sparkle",
                "color" : "Glittery Pink",
                "hornLength" : 32
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "Unicorn updated successfully"
          },
          "400" : {
            "$ref" : "#/components/responses/BadRequest"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "500" : {
            "$ref" : "#/components/responses/InternalServerError"
          }
        }
      },
      "delete" : {
        "summary" : "Delete a unicorn",
        "description" : "Remove a specific unicorn by ID",
        "responses" : {
          "204" : {
            "description" : "Unicorn deleted successfully"
          },
          "400" : {
            "$ref" : "#/components/responses/BadRequest"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "500" : {
            "$ref" : "#/components/responses/InternalServerError"
          }
        }
      },
      "parameters" : [ {
        "name" : "id",
        "in" : "path",
        "required" : true,
        "schema" : {
          "type" : "integer",
          "format" : "int32"
        }
      } ]
    }
  },
  "components" : {
    "schemas" : {
      "Error" : {
        "type" : "object",
        "required" : [ "detail", "status", "title", "type" ],
        "properties" : {
          "type" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          }
        }
      },
      "Unicorn" : {
        "type" : "object",
        "required" : [ "color", "hornLength", "id", "name" ],
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          },
          "color" : {
            "type" : "string"
          },
          "hornLength" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Length of the unicorn's horn in centimeters"
          }
        }
      },
      "UnicornInput" : {
        "type" : "object",
        "required" : [ "color", "hornLength", "name" ],
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "color" : {
            "type" : "string"
          },
          "hornLength" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Length of the unicorn's horn in centimeters"
          }
        }
      }
    },
    "responses" : {
      "BadRequest" : {
        "description" : "Bad request",
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            },
            "example" : {
              "type" : "https://example.com/probs/bad-request",
              "title" : "Bad Request",
              "status" : 400,
              "detail" : "The request was invalid or cannot be served."
            }
          }
        }
      },
      "Unauthorized" : {
        "description" : "Unauthorized",
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            },
            "example" : {
              "type" : "https://example.com/probs/unauthorized",
              "title" : "Unauthorized",
              "status" : 401,
              "detail" : "Authentication is required and has failed or has not been provided."
            }
          }
        }
      },
      "Forbidden" : {
        "description" : "Forbidden",
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            },
            "example" : {
              "type" : "https://example.com/probs/forbidden",
              "title" : "Forbidden",
              "status" : 403,
              "detail" : "The server understood the request but refuses to authorize it."
            }
          }
        }
      },
      "NotFound" : {
        "description" : "Not found",
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            },
            "example" : {
              "type" : "https://example.com/probs/not-found",
              "title" : "Not Found",
              "status" : 404,
              "detail" : "The requested resource could not be found."
            }
          }
        }
      },
      "InternalServerError" : {
        "description" : "Internal server error",
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Error"
            },
            "example" : {
              "type" : "https://example.com/probs/internal-server-error",
              "title" : "Internal Server Error",
              "status" : 500,
              "detail" : "The server encountered an unexpected condition that prevented it from fulfilling the request."
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}